rules_version = '2';

// Each user can only read/write their own subtree: users/{uid}/...
// Deploy: Firebase Console → Firestore → Rules (paste), or `npx firebase-tools deploy --only firestore:rules`.
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{uid}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == uid;

      // Optional hardening (single-user app): uncomment and put YOUR uid to lock the
      // project to your account only. Find your uid in Firebase Console → Authentication.
      // allow read, write: if request.auth != null && request.auth.uid == uid && uid == 'YOUR_UID';
    }

    // Everything else is denied.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
